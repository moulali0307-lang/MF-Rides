generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RIDER
  PARTNER
  ADMIN
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  STARTED
  COMPLETED
  CANCELLED
}

enum AdminOtpPurpose {
  LOGIN
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id           String  @id @default(uuid())
  fullName     String
  phoneNumber  String  @unique
  email        String? @unique
  passwordHash String
  role         Role    @default(RIDER)
  isOnline     Boolean @default(false)

  // MF Gold wallet
  goldBalance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rider / Partner rides
  ridesAsPassenger Ride[] @relation("PassengerRides")
  ridesAsRider     Ride[] @relation("RiderRides")

  // Admin security
  adminOtps     AdminOtp[]
  adminPasskeys AdminPasskey[]
  adminSessions AdminSession[]

  @@map("users")
}

model Ride {
  id     String     @id @default(uuid())
  status RideStatus @default(REQUESTED)

  passengerId String
  passenger   User   @relation("PassengerRides", fields: [passengerId], references: [id])

  riderId String?
  rider   User?   @relation("RiderRides", fields: [riderId], references: [id])

  // Pickup location
  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float

  // Destination location
  destinationAddress   String
  destinationLatitude  Float
  destinationLongitude Float

  // Ride fare
  fare Decimal @default(0) @db.Decimal(12, 2)

  // Ride OTP
  otpCode       String?
  otpExpiresAt  DateTime?
  otpVerifiedAt DateTime?

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  cancelledBy        String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([riderId])
  @@index([passengerId])
  @@map("rides")
}

model AdminOtp {
  id String @id @default(uuid())

  userId String

  purpose AdminOtpPurpose

  // Hashed OTP — actual OTP will never be stored
  codeHash String

  // Security
  attempts Int @default(0)

  // OTP validity
  expiresAt DateTime

  // Becomes non-null after successful verification
  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("admin_otps")
}

model AdminPasskey {
  id String @id @default(uuid())

  userId String

  // WebAuthn credential
  credentialId String @unique
  publicKey    String

  // WebAuthn signature counter
  counter Int @default(0)

  // Optional device information
  transports String?
  deviceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_passkeys")
}

model AdminSession {
  id String @id @default(uuid())

  userId String

  // Hashed session token
  tokenHash String @unique

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
